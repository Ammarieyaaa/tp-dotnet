@model ASPCoreFirstApp.ViewModels.MovieDetailsViewModel
@{
    ViewData["Title"] = "Détails du Film";
    var movie = Model.Movie;
}

<h1>@movie.Name</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    @* Message d'erreur retourné par RentalService (ou MongoDB) *@
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">ID</dt>
            <dd class="col-sm-8">@movie.Id</dd>
            <dt class="col-sm-4">Genre</dt>
            <dd class="col-sm-8">@movie.Genre?.Name</dd>
            <dt class="col-sm-4">Disponible</dt>
            <dd class="col-sm-8">@(movie.IsAvailable ? "Oui" : "Non (déjà loué)")</dd>
            <dt class="col-sm-4">Note moyenne</dt>
            <dd class="col-sm-8">
                @(Model.AverageRating.HasValue ? $"{Model.AverageRating.Value:0.0} / 5 ({Model.Reviews.Count} avis)" : "Aucun avis")
            </dd>
        </dl>

        @* Bouton "Louer" affiché SEULEMENT si le film est disponible *@
        @if (movie.IsAvailable)
        {
            <form asp-action="Rent" asp-route-id="@movie.Id" method="post" class="d-flex gap-2 mb-3">
                <select name="customerId" class="form-select" asp-items="Model.Customers"></select>
                <button type="submit" class="btn btn-success">Louer</button>
            </form>
        }

        <a asp-action="Edit" asp-route-id="@movie.Id">Modifier</a> |
        <a asp-action="Index">Retour à la liste</a>
    </div>

    <div class="col-md-6">
        <h4>Avis des clients <small class="text-muted">(MongoDB)</small></h4>

        @if (!Model.ReviewsAvailable)
        {
            <div class="alert alert-warning">MongoDB est injoignable : les avis ne peuvent pas être affichés.</div>
        }
        else if (Model.Reviews.Count == 0)
        {
            <p>Aucun avis pour ce film.</p>
        }

        @foreach (var r in Model.Reviews)
        {
            <div class="card mb-2">
                <div class="card-body py-2">
                    <strong>@r.Rating / 5</strong>
                    @if (r.Spoiler == true) { <span class="badge bg-danger">spoiler</span> }
                    @if (r.Language != null) { <span class="badge bg-info text-dark">@r.Language</span> }
                    <div>@r.Comment</div>
                    @foreach (var tag in r.Tags)
                    {
                        <span class="badge bg-secondary">@tag</span>
                    }
                </div>
            </div>
        }

        <h5 class="mt-3">Donner un avis</h5>
        <form asp-action="AddReview" asp-route-id="@movie.Id" method="post">
            <div class="mb-2">
                <label class="form-label">Note (1 à 5)</label>
                <input type="number" name="rating" min="1" max="5" value="5" class="form-control" required />
            </div>
            <div class="mb-2">
                <label class="form-label">Commentaire</label>
                <textarea name="comment" class="form-control"></textarea>
            </div>
            <div class="mb-2">
                <label class="form-label">Étiquettes (séparées par des virgules)</label>
                <input type="text" name="tags" class="form-control" placeholder="culte, visuel" />
            </div>
            <div class="mb-2 d-flex gap-3">
                <div class="form-check">
                    <input type="checkbox" name="spoiler" value="true" class="form-check-input" id="spoiler" />
                    <label class="form-check-label" for="spoiler">Contient un spoiler</label>
                </div>
                <input type="text" name="language" class="form-control form-control-sm w-auto" placeholder="Langue (fr, ar…)" />
            </div>
            <button type="submit" class="btn btn-primary">Envoyer</button>
        </form>
    </div>
</div>
