@model List<ASPCoreFirstApp.Models.Review>
@{
    ViewData["Title"] = "Avis clients";
    var movieNames = (Dictionary<int, string>)ViewBag.MovieNames;
}

<h1>Avis clients <small class="text-muted">(MongoDB)</small></h1>

@if (ViewBag.MongoError != null)
{
    <div class="alert alert-warning">@ViewBag.MongoError</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    <div class="col-md-7">
        @if (Model.Count == 0)
        {
            <p>Aucun avis pour le moment.</p>
        }
        @foreach (var r in Model)
        {
            <div class="card mb-2">
                <div class="card-body">
                    <h6 class="card-title">
                        @(movieNames.TryGetValue(r.MovieId, out var name) ? name : $"Film #{r.MovieId}")
                        — @r.Rating / 5
                    </h6>
                    <p class="card-text">@r.Comment</p>
                    @foreach (var tag in r.Tags)
                    {
                        <span class="badge bg-secondary">@tag</span>
                    }
                </div>
            </div>
        }
    </div>

    <div class="col-md-5">
        <h5>Donner un avis</h5>
        <form asp-action="Create" method="post">
            <div class="mb-2">
                <label class="form-label">Film</label>
                <select name="movieId" class="form-control" asp-items="ViewBag.Movies"></select>
            </div>
            <div class="mb-2">
                <label class="form-label">Note (1 à 5)</label>
                <input type="number" name="rating" min="1" max="5" value="5" class="form-control" />
            </div>
            <div class="mb-2">
                <label class="form-label">Commentaire</label>
                <textarea name="comment" class="form-control"></textarea>
            </div>
            <div class="mb-2">
                <label class="form-label">Étiquettes (séparées par des virgules)</label>
                <input type="text" name="tags" class="form-control" placeholder="culte, visuel" />
            </div>
            <button type="submit" class="btn btn-primary">Envoyer</button>
        </form>
    </div>
</div>
