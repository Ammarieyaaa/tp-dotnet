@model ASPCoreFirstApp.Models.Movie
@{
    ViewData["Title"] = "Ajouter un film";
}

<h1>Ajouter un film</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        @* asp-action génère aussi le jeton anti-falsification (CSRF) *@
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="GenreId" class="control-label"></label>
                @* Liste déroulante alimentée par ViewBag.GenreId (SelectList) *@
                <select asp-for="GenreId" class="form-control" asp-items="ViewBag.GenreId"></select>
                <span asp-validation-for="GenreId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Créer" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3"><a asp-action="Index">Retour à la liste</a></div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
