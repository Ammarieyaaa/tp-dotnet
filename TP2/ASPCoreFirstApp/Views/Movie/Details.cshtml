@model ASPCoreFirstApp.Models.Movie
@{
    ViewData["Title"] = "Détails du Film";
}

<h1>Détails du Film</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.Id</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Name)</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.GenreId)</dt>
        <dd class="col-sm-10">@Model.Genre?.Name</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.IsAvailable)</dt>
        <dd class="col-sm-10">@(Model.IsAvailable ? "Oui" : "Non")</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Modifier</a> |
    <a asp-controller="Review" asp-action="Index" asp-route-movieId="@Model.Id">Avis (MongoDB)</a> |
    <a asp-action="Index">Retour à la liste</a>
</div>
