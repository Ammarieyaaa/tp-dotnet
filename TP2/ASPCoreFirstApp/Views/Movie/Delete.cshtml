@model ASPCoreFirstApp.Models.Movie
@{
    ViewData["Title"] = "Supprimer un film";
}

<h1>Supprimer un film</h1>

<h3>Voulez-vous vraiment supprimer ce film ?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Name)</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.GenreId)</dt>
        <dd class="col-sm-10">@Model.Genre?.Name</dd>
    </dl>

    @* Le POST part vers l'action "Delete" → DeleteConfirmed grâce à [ActionName("Delete")] *@
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Supprimer" class="btn btn-danger" /> |
        <a asp-action="Index">Retour à la liste</a>
    </form>
</div>
